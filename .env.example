# EC2의 auditon 폴더에 .env로 복사해서 채운다. 이 파일(.env)은 깃에 올리지 않는다.

# LLM: replay(시연용 재생) | live(실제 호출)
AUDITON_LLM=replay
# OpenRouter 키 하나로 감사(Claude)·체크리스트(GPT)를 다른 제공사로 부른다
OPENROUTER_API_KEY=
AUDIT_MODEL=anthropic/claude-sonnet-5
CHECKLIST_MODEL=openai/gpt-5
# (선택) OpenRouter 대신 Anthropic 직접
ANTHROPIC_API_KEY=

# 화면 주소만 API를 부를 수 있게 (Cloudflare Pages 주소, 쉼표로 여러 개)
AUDITON_CORS=*

# Cloudflare Tunnel (도메인이 있을 때만)
CLOUDFLARE_TUNNEL_TOKEN=

# S3 백업 (deploy/backup.sh)
S3_BUCKET=
AWS_REGION=ap-northeast-2
