# EC2의 auditon 폴더에 .env로 복사해서 채운다. 이 파일(.env)은 깃에 올리지 않는다.

# LLM: replay(시연용 재생) | live(실제 호출)
AUDITON_LLM=replay
# 감사 모델 기본값: OpenRouter의 Gemini 2.5 Flash
OPENROUTER_API_KEY=
# 모델을 직접 지정할 때만 설정한다.
# AUDIT_MODEL=google/gemini-2.5-flash
# 체크리스트 LLM은 감사 LLM과 다른 제공사를 자동으로 고른다(기본 openai/gpt-5). 바꿀 때만:
# CHECKLIST_MODEL=openai/gpt-5
# (선택) OpenRouter 키 없이 Anthropic 직접 연결을 쓰면 Claude Sonnet 5가 기본값이다.
ANTHROPIC_API_KEY=

# 영수증 인식: 비워 두면 로컬 OCR(사진이 서버 밖으로 안 나감). gemini로 두면 사진을 Gemini(OpenRouter)로 보내 읽는다.
# AUDITON_OCR=gemini
# OCR_MODEL=google/gemini-2.5-flash

# 화면 주소만 API를 부를 수 있게 (Cloudflare Pages 주소, 쉼표로 여러 개)
AUDITON_CORS=*

# Cloudflare Tunnel (도메인이 있을 때만)
CLOUDFLARE_TUNNEL_TOKEN=

# S3 백업 (deploy/backup.sh)
S3_BUCKET=
AWS_REGION=ap-northeast-2
